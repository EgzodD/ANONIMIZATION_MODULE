# Скопируйте этот файл в .env и заполните своими значениями
# cp .env.example .env

# ── PostgreSQL ──────────────────────────────────────────
POSTGRES_USER=user
POSTGRES_PASSWORD=changeme
POSTGRES_DB=conversations_db

# ── Сервис анонимизации ──────────────────────────────────
DATABASE_URL=postgresql://user:changeme@db:5432/conversations_db

# API-ключ для защиты эндпоинтов /anonymize/*
# Оставьте пустым чтобы отключить аутентификацию (только для разработки)
API_KEY=

# Секрет для верификации подписи Chatwoot webhook
# Берётся из Chatwoot: Settings -> Integrations -> Webhooks -> Secret Token
# Оставьте пустым чтобы отключить проверку подписи
CHATWOOT_WEBHOOK_SECRET=

# ── Модель распознавания ФИО (PERSON) ────────────────────
# Путь к дообученной ruBERT-модели (папка с config.json).
# Задан -> модуль использует обученную модель; пусто -> стоковая Natasha.
# Требует установленных transformers и torch в окружении.
# В Docker путь указывать внутри контейнера (например /app/models/person_ruBERT).
PERSON_MODEL_DIR=
